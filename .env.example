# Xboard 环境配置模板。
# 复制为 .env 后按机器修改；.env 不入库，开发机与生产机各自维护一份。

APP_NAME=XBoard
APP_ENV=production
# 留空由 php artisan xboard:install 生成，切勿在两台机器间复用同一份 .env。
APP_KEY=
APP_DEBUG=false
# 用户实际访问的地址。开发机填公网 IP，生产机填 nginx 对外的域名。
APP_URL=http://127.0.0.1:7001

# ---------------------------------------------------------------------------
# 部署参数（compose.yaml 读取，两台机器的唯一差异就在这里）
# ---------------------------------------------------------------------------
# 端口绑定地址：
#   0.0.0.0    公网直连，开发机用
#   127.0.0.1  仅本机监听，由宿主机 nginx 反代，生产机用
XBOARD_BIND_IP=127.0.0.1
XBOARD_PORT=7001
# 容器资源档位：minimal | balanced | performance | auto
RESOURCE_PROFILE=balanced
# 构建加速源，默认阿里云（定义在 compose.yaml）。国内机器保持注释即可。
# 海外机器（生产机）取消下面两行注释、保持空值，回到 alpine / packagist 官方源；
# 忘了改也只是构建慢一些，不会失败。
# ALPINE_MIRROR=
# COMPOSER_MIRROR=

LOG_CHANNEL=stack

# ---------------------------------------------------------------------------
# 数据库：SQLite 文件位于 .docker/.data/，已挂载到宿主机，重建容器不丢数据。
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=.docker/.data/database.sqlite

# Redis 由容器内 supervisor 拉起，走 unix socket。
REDIS_HOST=/data/redis.sock
REDIS_PASSWORD=
REDIS_PORT=0

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# 安装完成后置为 1，阻止重复安装。
INSTALLED=0
